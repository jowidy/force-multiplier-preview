---
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';
import { site } from '../lib/site';
---

<SiteLayout
  title="Contact"
  description="Tell Force Multiplier what feels stuck. Start a conversation about your marketing, website or operations by email or text."
  path="/contact"
>
  <section class="page-intro contact-intro wrap">
    <h1>Let’s talk<br />about the work.</h1><p class="lead">
      Tell us what you do, what you are trying to change and where you could use a hand. A short
      note is enough.
    </p>
  </section>
  <section class="wrap contact-grid section-bottom">
    <div>
      <p class="form-note">
        This review site prepares an email in your email app. You review it and send it there.
        Nothing is submitted or stored by this form. You can also <a href={`mailto:${site.email}`}
          >email us directly</a
        >.
      </p><form id="inquiry-form" data-email={site.email}>
        <fieldset id="inquiry-fields" disabled>
          <div class="field-row">
            <div class="field">
              <label for="name">Your name</label><input
                id="name"
                name="name"
                autocomplete="name"
                required
                maxlength="100"
              />
            </div><div class="field">
              <label for="email">Email address</label><input
                id="email"
                name="email"
                type="email"
                autocomplete="email"
                required
                maxlength="254"
              />
            </div>
          </div><div class="field">
            <label for="business"
              >Business or organization <span class="small">(optional)</span></label
            ><input id="business" name="business" autocomplete="organization" maxlength="160" />
          </div><div class="field">
            <label for="interest">What could use a hand?</label><select
              id="interest"
              name="interest"
              ><option>Help me work out where to start</option><option
                >Local search and Google Ads</option
              ><option>Website and messaging</option><option
                >Marketing operations and automation</option
              ><option>Strategy and delivery support</option></select>
          </div><div class="field">
            <label for="message">What feels stuck?</label><textarea
              id="message"
              name="message"
              required
              maxlength="3000"
              aria-describedby="message-help"></textarea><small id="message-help"
              >A few sentences about the situation and what you hope to change.</small>
          </div><div class="form-actions">
            <button class="button" type="submit">Open email draft <Icon /></button><button
              class="button button-outline"
              id="copy-inquiry"
              type="button">Copy inquiry <Icon name="right" /></button>
          </div><p id="form-status" class="form-status" role="status" aria-live="polite"></p><div
            id="copy-fallback"
            class="field"
            hidden
          >
            <label for="inquiry-copy">Copy this message into your email</label><textarea
              id="inquiry-copy"
              aria-describedby="form-status"
              readonly
              rows="8"></textarea>
          </div>
        </fieldset><noscript
          ><p>
            Email <a href={`mailto:${site.email}`}>{site.email}</a> directly. The draft builder requires
            JavaScript.
          </p></noscript>
      </form>
    </div><aside class="contact-side">
      <h2>Prefer to reach out directly?</h2><a class="email" href={`mailto:${site.email}`}
        >{site.email}</a
      ><p>
        <a class="text-link" href={`sms:${site.phone}`}>Text {site.displayPhone} <Icon /></a>
      </p><hr /><h2>A useful first note</h2><ul>
        <li>What your business does</li><li>Where things are getting stuck</li><li>
          What a better result would look like
        </li><li>Any timing or constraints that matter</li>
      </ul><hr /><h2>Find us in Monroe</h2><address>{site.address}</address><p class="small">
        Please get in touch before planning a visit.
      </p>
    </aside>
  </section>
  <section class="section pale-section">
    <div class="wrap faq-section">
      <h2>Before we talk.</h2><details>
        <summary>Do I need to know which service I need?</summary><p>
          No. Describe the situation in your own words. The first job is to understand the problem,
          then work out which kind of help fits.
        </p>
      </details><details>
        <summary>How is the work priced?</summary><p>
          We scope the work around the business, the responsibilities and the level of ongoing
          support. Advertising spend is separate and agreed before campaigns go live.
        </p>
      </details><details>
        <summary>Can you work with our current tools or website?</summary><p>
          Yes. We start by looking at what is already in place. Sometimes the right next step is a
          focused improvement; sometimes the underlying setup needs more attention.
        </p>
      </details><details>
        <summary>Do you guarantee a number of leads?</summary><p>
          No. We focus on the parts that affect visibility, customer fit and follow-through, and
          agree on a practical way to measure the work.
        </p>
      </details>
    </div>
  </section>
  <script>
    const form = document.querySelector<HTMLFormElement>('#inquiry-form');
    const status = document.querySelector<HTMLElement>('#form-status');
    const fields = document.querySelector<HTMLFieldSetElement>('#inquiry-fields');
    const copyButton = document.querySelector<HTMLButtonElement>('#copy-inquiry');
    const fallback = document.querySelector<HTMLElement>('#copy-fallback');
    const copyArea = document.querySelector<HTMLTextAreaElement>('#inquiry-copy');
    if (form && fields && status && copyButton && fallback && copyArea) {
      const validate = () => {
        for (const id of ['name', 'message']) {
          const field = form.querySelector<HTMLInputElement | HTMLTextAreaElement>(`#${id}`);
          if (field)
            field.setCustomValidity(
              field.value.trim() ? '' : 'Please enter a few words before continuing.',
            );
        }
        return form.reportValidity();
      };
      form.addEventListener('input', (event) => {
        if (event.target instanceof HTMLInputElement || event.target instanceof HTMLTextAreaElement)
          event.target.setCustomValidity('');
      });
      const compose = () => {
        const data = new FormData(form);
        const value = (key: string) => String(data.get(key) || '').trim();
        return {
          subject: `Website inquiry: ${value('interest')}`,
          body: `Name: ${value('name')}\nEmail: ${value('email')}\nBusiness: ${value('business') || 'Not provided'}\nHelp with: ${value('interest')}\n\n${value('message')}`,
        };
      };
      const showFallback = (text: string) => {
        fallback.hidden = false;
        copyArea.value = text;
      };
      form.addEventListener('submit', (event) => {
        event.preventDefault();
        if (!validate()) return;
        const { subject, body } = compose();
        showFallback(`To: ${form.dataset.email}\nSubject: ${subject}\n\n${body}`);
        const url = `mailto:${form.dataset.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
        if (url.length > 1900) {
          status.textContent =
            'Your note is ready below. It is too long for a reliable email-app link. Copy it and email it to ' +
            form.dataset.email +
            '. Nothing has been sent.';
          copyArea.focus();
          return;
        }
        status.textContent =
          'Your email app should open a draft. Review it and send it there. If it does not open, copy your inquiry below. Nothing has been sent by this website.';
        window.location.href = url;
      });
      copyButton.addEventListener('click', async () => {
        if (!validate()) return;
        const { subject, body } = compose();
        const text = `To: ${form.dataset.email}\nSubject: ${subject}\n\n${body}`;
        showFallback(text);
        copyButton.disabled = true;
        try {
          if (!navigator.clipboard) throw new Error('Clipboard unavailable');
          await navigator.clipboard.writeText(text);
          status.textContent =
            'Inquiry copied. Paste it into your email app and send it to ' +
            form.dataset.email +
            '. Nothing has been sent by this website.';
        } catch {
          status.textContent =
            'Automatic copying is unavailable. Select and copy the prepared message below, then paste it into your email app.';
          copyArea.focus();
          copyArea.select();
        } finally {
          copyButton.disabled = false;
        }
      });
      fields.disabled = false;
    }
  </script>
</SiteLayout>
