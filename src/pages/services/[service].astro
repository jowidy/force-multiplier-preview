---
import SiteLayout from '../../layouts/SiteLayout.astro';
import EditorialArt from '../../components/EditorialArt.astro';
import ServiceInquiry from '../../components/ServiceInquiry.astro';
import Icon from '../../components/Icon.astro';
import { services } from '../../lib/service-catalog';
import { href } from '../../lib/site';
export function getStaticPaths() {
  return services.map((service) => ({ params: { service: service.slug }, props: { service } }));
}
const { service } = Astro.props;
const monthly = service.category === 'monthly';
---

<SiteLayout
  title={`${service.shortTitle} for $400`}
  description={`${service.lead} $400 ${monthly ? 'per month, month-to-month' : 'one time'}, with a separate agreement and clear outside costs.`}
  path={`/services/${service.slug}`}
>
  <section class="hero-stage service-hero">
    <div class="wrap hero">
      <div class="hero-copy">
        <a class="back-link" href={href('/services')}>← All $400 services</a><p class="eyebrow">
          {service.eyebrow}
        </p><h1>{service.headline}</h1><p class="lead">{service.lead}</p><div class="service-price">
          <strong>$400</strong><span
            >{monthly ? 'per month' : 'one time'}<small
              >{
                monthly
                  ? 'Month-to-month. Your own agreement.'
                  : 'One focused project. Your own agreement.'
              }</small
            ></span
          >
        </div><a class="button" href="#request">Schedule a call <Icon /></a><p
          class="hero-fineprint"
        >
          Ad spend, software and other third-party costs are separate where needed. Scope agreed
          together, before the agreement and the start of work.
        </p>
      </div>
      <div class="service-art">
        <EditorialArt
          kind={['posts', 'people', 'ads', 'search', 'email', 'profile'].includes(service.icon)
            ? 'connected-work'
            : 'clear-path'}
          priority
          caption
        /><div class="art-note"><span aria-hidden="true">✦</span><p>{service.benefit}</p></div>
      </div>
    </div>
  </section>
  <section class="section cream-section">
    <div class="wrap scope-grid">
      <div>
        <p class="eyebrow">Here’s the useful part</p><h2>What we’ll<br />help you do.</h2><p>
          {service.benefit}
        </p>
      </div><ul class="deliverables">
        {
          service.deliverables.map((item, index) => (
            <li>
              <>
                <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                <p>{item}</p>
              </>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
  <section class="section wrap scope-grid">
    <div>
      <p class="eyebrow">Made to fit your business</p><h2>
        A clear start.<br />Less back-and-forth.
      </h2><p>
        Start with a conversation about your goals and what is already in place. We'll agree the
        scope and access plan, sign a separate contract, then arrange the inputs needed to begin.
      </p>
    </div><div>
      <h3>What we’ll need from you</h3><ul class="plain-list">
        {service.preparation.map((item) => <li>{item}</li>)}
      </ul><p class="ownership-note">
        You keep control of your accounts and approved deliverables. We’ll agree access and
        approvals together. Required inputs and appropriate access come before the agreed service
        and billing start. Never share passwords in this preview.
      </p>
    </div>
  </section>
  <section class="section scope-review-section">
    <div class="wrap scope-grid">
      <div>
        <p class="eyebrow">Before we agree the work</p><h2>Small print,<br />in plain sight.</h2><p>
          These draft boundaries need review before we sign an agreement. The $400 price is public;
          the specific work belongs in your agreement.
        </p>
      </div><div class="scope-review">
        <h3>Scope to confirm</h3><ul>{service.scopeReview.map((item) => <li>{item}</li>)}</ul><p
          class="small"
        >
          Review note: the included work is listed above. Details marked for confirmation remain
          draft decisions and will be settled in your agreement.
        </p><h3>Costs outside the $400 fee</h3><p>{service.costs}</p>
      </div>
    </div>
  </section>
  <section class="section wrap faq-section">
    <h2>A few good questions.</h2>{
      service.faq.map((f) => (
        <details>
          <>
            <summary>{f.question}</summary>
            <p>{f.answer}</p>
          </>
        </details>
      ))
    }<details>
      <summary>Am I committing to a package of services?</summary><p>
        No. Each service is separately contracted for $400. Pick the work you need. Monthly services
        are month-to-month, and one-time projects have their own billing terms. We agree scope,
        third-party costs, required inputs and account access before work starts. Recurring billing
        is handled through QuickBooks from the agreed start.
      </p>
    </details>
  </section>
  <section class="section request-section">
    <div class="wrap"><ServiceInquiry selected={service.slug} /></div>
  </section>
  <section class="section wrap">
    <div class="section-heading">
      <h2>Another useful<br />next step.</h2><p>
        Add another service only when it makes sense. Each has its own agreement.
      </p>
    </div><div class="related-services">
      {
        service.related
          .map((slug) => services.find((s) => s.slug === slug))
          .filter(Boolean)
          .map((s) => (
            <a class="related-card" href={href(`/services/${s!.slug}`)}>
              <>
                <p class="eyebrow">$400 {s!.category === 'monthly' ? 'per month' : 'one time'}</p>
                <h3>{s!.shortTitle}</h3>
                <p>{s!.benefit}</p>
                <span class="text-link">
                  See the service <Icon />
                </span>
              </>
            </a>
          ))
      }
    </div>
  </section>
</SiteLayout>
