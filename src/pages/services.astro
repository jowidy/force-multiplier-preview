---
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';
import CallToAction from '../components/CallToAction.astro';
import { href, serviceGroups } from '../lib/site';
---

<SiteLayout
  title="Services"
  description="Local search, Google Ads, websites, messaging, marketing operations and strategy. Find the right kind of support for the work ahead."
  path="/services"
>
  <section class="page-intro wrap">
    <h1>The right help<br />for the next step.</h1><p class="lead">
      Start with the problem in front of you. We can help work out which combination of marketing,
      strategy and delivery support will make a difference.
    </p>
  </section>
  <section class="wrap section-bottom">
    <div class="service-list service-list-full">
      {
        serviceGroups.map((s) => (
          <a class="service-row" href={href(s.path)}>
            <>
              <div>
                <>
                  <h2>{s.title}</h2>
                  <p class="service-detail">{s.detail}</p>
                </>
              </div>
              <p class="service-explanation">{s.text}</p>
              <Icon />
            </>
          </a>
        ))
      }
    </div>
  </section>
  <section class="section pale-section">
    <div class="wrap split-grid">
      <div>
        <h2>More specific<br />help.</h2><p>
          Already know where the problem sits? Explore the work in more detail.
        </p>
      </div><div class="link-list">
        <a href={href('/seo-lead-generation')}>SEO + lead generation <Icon /></a><a
          href={href('/ai-workflow-automation')}>AI + workflow automation <Icon /></a
        ><a href={href('/marketing-operations-consulting')}
          >Marketing operations consulting <Icon /></a
        ><a href={href('/go-to-market-strategy')}>Go-to-market strategy <Icon /></a>
      </div>
    </div>
  </section>
  <section class="section wrap split-grid">
    <div>
      <h2>Built around<br />your business.</h2><p>
        Customer questions and the way work gets booked differ from one business to another. The
        plan should reflect that.
      </p>
    </div><div class="link-list">
      <a href={href('/seo-google-ads-local-business')}>Local businesses <Icon /></a><a
        href={href('/dumpster-rental-marketing')}>Dumpster rental businesses <Icon /></a
      ><a href={href('/woodworking-business-marketing')}>Woodworking businesses <Icon /></a>
    </div>
  </section>
  <section class="section ink-section">
    <div class="wrap split-grid">
      <h2>What an engagement<br />should make clear.</h2><div class="prose">
        <p>
          The scope, who is responsible, the next decision and how we will review the work. Support
          can focus on a particular problem or continue across implementation and operations.
        </p><p>
          We scope the work around the business. Any advertising spend is separate and agreed before
          a campaign goes live.
        </p><a class="text-link" href={href('/case-studies')}
          >See how that looks in practice <Icon /></a>
      </div>
    </div>
  </section>
  <CallToAction
    title="Not sure which service you need?"
    text="Tell us what is happening. You do not need to diagnose the problem or know the marketing vocabulary first."
  />
</SiteLayout>
