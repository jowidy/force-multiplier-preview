---
import SiteLayout from '../layouts/SiteLayout.astro';
import EditorialArt from '../components/EditorialArt.astro';
import Icon from '../components/Icon.astro';
import PriceComparison from '../components/PriceComparison.astro';
import { services } from '../lib/service-catalog';
import { href } from '../lib/site';
---

<SiteLayout
  title="Useful services. $400 each."
  description="Pick practical marketing and website help for your small business. Month-to-month services and one-time projects, each separately contracted for $400."
  path="/services"
>
  <section class="page-intro wrap illustrated-intro catalog-hero">
    <div>
      <p class="eyebrow">Small-business marketing, made simpler</p><h1>
        Pick the help.<br />Know the price.
      </h1><p class="lead">
        Useful services. <strong>$400 each.</strong> Choose the work your business needs, with a separate
        agreement for every service.
      </p><ul class="catalog-summary">
        <li>Month-to-month services</li><li>One-time projects</li><li>Your accounts stay yours</li>
      </ul>
      <a class="text-link" href="#price-comparison">Compare our service prices <Icon /></a>
      <p><a class="button" href={href('/contact') + '#request'}>Schedule a call <Icon /></a></p>
    </div><EditorialArt kind="clear-path" priority />
  </section>
  <PriceComparison />
  <section class="section cream-section">
    <div class="wrap">
      <nav class="catalog-controls" aria-label="Service categories">
        <a href="#monthly">Monthly support ↓</a><a href="#one-time">One-time projects ↓</a><a
          href="#how-it-works">How it works ↓</a
        >
      </nav>
      {
        [
          {
            key: 'monthly',
            id: 'monthly',
            title: 'A little help, every month.',
            description:
              'Keep the work moving with ongoing support. Each service is $400 per month, on its own month-to-month agreement.',
          },
          {
            key: 'once',
            id: 'one-time',
            title: 'One job. A clearer next step.',
            description:
              'Get a focused project off your list. Each service is $400 one time, with the work agreed before it starts.',
          },
        ].map((group) => (
          <section class="catalog-group" id={group.id}>
            <>
              <div class="catalog-heading">
                <>
                  <h2>{group.title}</h2>
                  <p>{group.description}</p>
                </>
              </div>
              <div class="catalog-grid">
                {services
                  .filter((s) => s.category === group.key)
                  .map((s) => (
                    <article class="service-card">
                      <div class="card-number">
                        <span>{group.key === 'monthly' ? 'MONTHLY' : 'ONE TIME'}</span>
                        <span aria-hidden="true">✦</span>
                      </div>
                      <h3>{s.shortTitle}</h3>
                      <p>{s.benefit}</p>
                      <p class="card-price">
                        <strong>$400</strong> {group.key === 'monthly' ? 'per month' : 'one time'}
                      </p>
                      <a class="text-link" href={href(`/services/${s.slug}`)}>
                        What’s included <Icon />
                      </a>
                    </article>
                  ))}
              </div>
            </>
          </section>
        ))
      }
    </div>
  </section>
  <section class="section wrap scope-grid" id="how-it-works">
    <div>
      <p class="eyebrow">Simple selection. Clear ownership.</p><h2>
        Start with one<br />useful thing.
      </h2><p>
        You don’t have to buy a bundle or commit to a long program. Choose the service that helps
        most right now.
      </p><a class="button" href={href('/contact') + '#request'}>Schedule a call <Icon /></a>
    </div><ol class="process-list">
      <li>
        <h3>Start with a conversation.</h3><p>
          Schedule a call about your goals, the service that fits and the accounts or tools already
          in place. A brief is optional; bring your questions.
        </p>
      </li><li>
        <h3>Agree the work.</h3><p>
          Confirm the scope, outside costs, responsibilities and access plan. Review and sign a
          separate contract for each service.
        </p>
      </li><li>
        <h3>Get ready, then get started.</h3><p>
          Complete the required onboarding and access steps, then confirm the service and billing
          start. Monthly services use recurring QuickBooks billing on the agreed month-to-month
          terms. One-time projects follow their agreed billing terms. Your accounts stay yours.
        </p>
      </li>
    </ol>
  </section>
  <section class="section price-explainer">
    <div class="wrap home-price-grid">
      <div>
        <p class="eyebrow">No price guessing</p><h2>Know the fee.<br />Know what’s extra.</h2><p>
          The $400 fee pays for the agreed service. It does not include advertising spend, software
          subscriptions, hosting, domains or other third-party charges where needed.
        </p><p>
          We identify those costs before you sign an agreement. This review preview prepares
          conversation notes; it does not send an inquiry, reserve a time or start a contract.
        </p>
      </div><div class="price-powder">
        <p class="eyebrow">One service. One agreement.</p>
        <p class="price-static">$400</p>
        <p>Per month for ongoing help, or one time for a focused project.</p>
        <a class="text-link" href="#price-comparison">Back to service comparisons <Icon /></a>
      </div>
    </div>
  </section>
</SiteLayout>
