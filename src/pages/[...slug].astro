---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';
import CallToAction from '../components/CallToAction.astro';
import EditorialArt from '../components/EditorialArt.astro';
import CaseCover from '../components/CaseCover.astro';
import { href } from '../lib/site';
export async function getStaticPaths() {
  return (await getCollection('entries', (e) => !e.data.draft)).map((entry) => ({
    params: { slug: entry.data.path.replace(/^\//, '') },
    props: { entry },
  }));
}
interface Props {
  entry: CollectionEntry<'entries'>;
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const d = entry.data;
const all = await getCollection('entries', (e) => !e.data.draft);
const related = all.filter((e) => d.related.includes(e.data.path));
const parent =
  d.kind === 'case'
    ? ['Work', '/case-studies']
    : d.kind === 'article'
      ? ['Insights', '/insights']
      : ['Services', '/services'];
---

<SiteLayout title={d.title} description={d.description} path={d.path}>
  <section class="detail-intro wrap">
    <a class="breadcrumb" href={href(parent[1])}>{parent[0]}</a><h1>{d.title}</h1><p class="lead">
      {d.lead}
    </p><div class="detail-meta">
      <span>{d.category}</span>{d.kind === 'case' && <span>Anonymized case study</span>}{
        d.kind === 'article' && <span>Force Multiplier</span>
      }
    </div>
  </section>
  <div class="wrap detail-grid section-bottom">
    <article class="prose">
      <div class="detail-art">
        {
          d.kind === 'case' ? (
            <CaseCover path={d.path} />
          ) : (
            <EditorialArt
              kind={
                d.path.includes('seo') || d.path.includes('lead') || d.path.includes('website')
                  ? 'connected-work'
                  : 'clear-path'
              }
              caption
            />
          )
        }
      </div>
      <Content />{
        d.takeaway && (
          <div class="takeaway">
            <>
              <h2>The practical takeaway</h2>
              <p>{d.takeaway}</p>
            </>
          </div>
        )
      }
    </article><aside class="detail-aside">
      <nav aria-label="On this page">
        <h2>
          In this {d.kind === 'case' ? 'case' : d.kind === 'article' ? 'guide' : 'service'}
        </h2><ul>
          {
            headings
              .filter((h) => h.depth === 2)
              .map((h) => (
                <li>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))
          }
        </ul>
      </nav><div class="aside-contact">
        <h2>Make it practical.</h2><p>Tell us how this shows up in your business.</p><a
          class="text-link"
          href={href('/contact')}>Start a conversation <Icon /></a
        >
      </div>
    </aside>
  </div>
  {
    related.length > 0 && (
      <section class="section pale-section">
        <div class="wrap">
          <>
            <h2 class="related-heading">Keep exploring.</h2>
            <div class="related-list">
              {related.map((item) => (
                <a href={href(item.data.path)}>
                  <span>{item.data.category}</span>
                  <h3>{item.data.title}</h3>
                  <Icon />
                </a>
              ))}
            </div>
          </>
        </div>
      </section>
    )
  }
  <CallToAction />
</SiteLayout>
