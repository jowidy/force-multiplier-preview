---
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';
import CallToAction from '../components/CallToAction.astro';
import EditorialArt from '../components/EditorialArt.astro';
import CaseCover from '../components/CaseCover.astro';
import PricePowder from '../components/PricePowder.astro';
import PricingExamples from '../components/PricingExamples.astro';
import { services } from '../lib/service-catalog';
import { href, asset } from '../lib/site';
---

<SiteLayout
  title="Force Multiplier"
  description="Force Multiplier, the $400 ad agency for small businesses. Pick practical marketing and website services, with a clear price and a separate agreement for each."
>
  <section class="hero-stage">
    <div class="hero wrap">
      <div class="hero-copy">
        <h1 class="national-positioning">
          Force Multiplier,<br />the <span>$400 ad agency</span><br />for small businesses.
        </h1><p class="lead">
          More time for your business. A little help with the marketing. Choose one useful service,
          know the price, and keep control.
        </p><div class="actions">
          <a class="button" href={href('/services')}>Find your $400 service <Icon /></a><a
            class="text-link"
            href={href('/case-studies')}>See our work <Icon name="right" /></a
          >
        </div><p class="hero-location">
          Monthly or one time. Each service has its own agreement.<br />Advertising spend and other
          third-party costs are separate.
        </p>
      </div>
      <EditorialArt priority caption />
    </div>
  </section>
  <a class="proof-ribbon" href={href('/case-studies/local-service-wrong-clicks')}>
    <span class="wrap proof-ribbon-inner"
      ><span>From the work</span><strong>Getting the right people to the right business.</strong
      ><span class="text-link">Read the case <Icon /></span></span
    >
  </a>
  <section class="section services-section" aria-labelledby="services-heading">
    <div class="wrap">
      <div class="section-heading">
        <h2 id="services-heading">What could you<br />use a hand with?</h2><p>
          Monthly services. One-time projects.<br class="desktop-break" /> All $400 each. Pick a useful
          place to start.
        </p>
      </div><div class="home-offer-list">
        {
          ['social-posts', 'google-ads', 'homepage']
            .map((slug) => services.find((s) => s.slug === slug)!)
            .map((service) => (
              <a href={href(`/services/${service.slug}`)}>
                <>
                  <p class="eyebrow">
                    $400 {service.category === 'monthly' ? 'per month' : 'one time'}
                  </p>
                  <h3>{service.shortTitle}</h3>
                  <p>{service.benefit}</p>
                  <span class="text-link">
                    See the service <Icon />
                  </span>
                </>
              </a>
            ))
        }
      </div><a class="text-link section-link" href={href('/services')}
        >Explore our services <Icon name="right" /></a
      >
    </div>
  </section>
  <section class="section work-section">
    <div class="wrap">
      <div class="section-heading">
        <h2>A closer look<br />at the work.</h2><div>
          <p>Specific problems. Practical interventions. A clear account of what changed.</p><a
            class="text-link"
            href={href('/case-studies')}>View all work <Icon /></a
          >
        </div>
      </div><div class="featured-work">
        <a class="work-feature" href={href('/case-studies/customer-questions-search-pages')}
          ><CaseCover path="customer-questions" /><div class="work-feature-body">
            <div class="work-feature-top"><span>Search + content</span><Icon /></div><h3>
              Turn customer questions into pages that help.
            </h3><p>
              Building useful search content around the questions people ask before they are ready
              to make contact.
            </p><span class="text-link">See the approach <Icon name="right" /></span>
          </div></a
        ><a class="work-feature light" href={href('/case-studies/local-proof-online')}
          ><CaseCover path="local-proof-online" /><div class="work-feature-body">
            <div class="work-feature-top"><span>Scope + operations</span><Icon /></div><h3>
              A clearer scope.<br />A more workable plan.
            </h3><p>
              How a narrower first phase changed an estimated 60 hours of work to 30. A scope
              decision, not a claim of realized savings.
            </p><span class="text-link">Read the case <Icon name="right" /></span>
          </div></a
        >
      </div>
    </div>
  </section>
  <section class="section wrap home-price-grid">
    <div>
      <p class="eyebrow">Clear price. Real choices.</p><h2>
        A smaller decision.<br />A useful next move.
      </h2><p>
        Choose ongoing help or get one project finished. Each service comes with its own $400
        agreement, so you can start with what matters and add more only when it makes sense.
      </p><p>
        We confirm the scope and outside costs first. You keep control of your accounts and approved
        work.
      </p><a class="text-link" href={href('/services')}>Find the right fit <Icon /></a>
    </div><PricePowder />
  </section>
  <section class="section process-section">
    <div class="wrap process-grid">
      <div>
        <h2>Start with what<br />you have.</h2><p class="lead">
          A useful first step should make the next one easier.
        </p><a class="text-link" href={href('/contact')}>Tell us what feels stuck <Icon /></a>
      </div><ol class="process-list">
        <li>
          <h3>Understand the situation.</h3><p>
            We look at the business, the customer and the work already in motion. Then we identify
            where things are getting stuck.
          </p>
        </li><li>
          <h3>Choose the first practical fix.</h3><p>
            Agree on a useful scope, clear responsibilities and the evidence that will tell us
            whether the work helped.
          </p>
        </li><li>
          <h3>Build, check and follow through.</h3><p>
            Put the plan into practice, review what happens and make the next decision with a
            clearer view.
          </p>
        </li>
      </ol>
    </div>
  </section>
  <section class="section people-section">
    <div class="wrap people-grid">
      <div class="people-portrait">
        <img
          src={asset('/images/john-dye-420.webp')}
          srcset={`${asset('/images/john-dye-420.webp')} 420w, ${asset('/images/john-dye.webp')} 834w`}
          sizes="(min-width: 900px) 360px, 280px"
          width="420"
          height="498"
          alt="John Dye, Head of Strategy at Force Multiplier"
          loading="lazy"
        />
      </div><div>
        <h2>Strategy stays close<br />to the work.</h2><p class="lead">
          Force Multiplier connects direction with delivery.
        </p><p>
          Led in strategy by John Dye, we help local businesses and larger teams make sense of the
          next move, then help carry it through. The work can span a clearer website, a better
          search campaign or the process behind the follow-up.
        </p><p class="person-signature"><strong>John Dye</strong><span>Head of Strategy</span></p><a
          class="text-link"
          href={href('/about')}>Meet Force Multiplier <Icon /></a
        >
      </div>
    </div>
  </section>
  <section class="studio-section">
    <div class="studio-image">
      <img
        src={asset('/images/fm-studio-960.webp')}
        srcset={`${asset('/images/fm-studio-640.webp')} 640w, ${asset('/images/fm-studio-960.webp')} 960w`}
        sizes="(min-width: 900px) 60vw, 100vw"
        width="960"
        height="540"
        loading="lazy"
        alt="Force Multiplier workspace with a blue sofa, yellow chair, artwork and the Force Multiplier wall sign"
      />
    </div>
    <div class="studio-copy">
      <h2>Local roots.<br />A wider view.</h2><p>
        Based in Monroe, Louisiana. Working wherever the work takes us.
      </p><a class="text-link" href={href('/about')}>Meet Force Multiplier <Icon /></a>
    </div>
  </section>
  <CallToAction />
  <PricingExamples />
</SiteLayout>
