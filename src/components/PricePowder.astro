---
import { agencyBenchmarks } from '../lib/agency-benchmarks';
import { href } from '../lib/site';
const googleAds = agencyBenchmarks.find((benchmark) => benchmark.slug === 'google-ads')!;
---

<div class="price-powder" data-powder>
  <p class="eyebrow">Clear prices. Different scopes.</p>
  <div class="powder-price">
    <span class="price-static">$400</span>
    <span class="provider-overlay" aria-hidden="true"
      ><small>Other Agencies</small><strong>{googleAds.price}</strong><small
        >{googleAds.period} · Google Ads management</small
      ></span
    >
    <span class="powder-cloud" aria-hidden="true"
      >{
        Array.from({ length: 28 }, (_, i) => (
          <i style={`--i:${i};--x:${((i * 37) % 280) - 140}px;--y:${-40 - ((i * 29) % 150)}px`} />
        ))
      }</span
    >
  </div>
  <p>
    <strong>Force Multiplier: $400 {googleAds.fmPeriod}</strong><br />Google Ads management,
    optimization and testing. Month-to-month, under a separate agreement.
  </p>
  <div class="powder-actions">
    <button class="powder-trigger" type="button" hidden data-play-powder
      >Reveal the FM price <span aria-hidden="true">✦</span></button
    ><button type="button" class="powder-trigger" hidden data-skip-powder>Skip animation</button>
  </div>
  <p class="small">
    <strong>{googleAds.price} {googleAds.period} agency estimate:</strong>
    {googleAds.tooltipSummary}
    Recurring agency onboarding and ad spend are separate.
    <a href={`${href('/services')}#price-comparison`}>See all service comparisons.</a>
  </p>
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-powder]').forEach((card) => {
    const play = card.querySelector<HTMLButtonElement>('[data-play-powder]');
    const skip = card.querySelector<HTMLButtonElement>('[data-skip-powder]');
    if (!play || !skip) return;
    const motion = matchMedia('(prefers-reduced-motion: reduce)');
    let timer: ReturnType<typeof setTimeout>;
    const finish = () => {
      const restoreFocus = document.activeElement === skip;
      clearTimeout(timer);
      card.classList.remove('is-sparkling');
      card.classList.add('is-revealed');
      skip.hidden = true;
      play.setAttribute('aria-disabled', 'false');
      play.textContent = 'Play price reveal again';
      if (restoreFocus) play.focus();
    };
    const sync = () => {
      clearTimeout(timer);
      card.classList.toggle('motion-ready', !motion.matches);
      card.classList.remove('is-sparkling', 'is-revealed');
      play.hidden = motion.matches;
      skip.hidden = true;
      play.setAttribute('aria-disabled', 'false');
    };
    sync();
    motion.addEventListener('change', sync);
    play.addEventListener('click', () => {
      if (motion.matches || play.getAttribute('aria-disabled') === 'true') return;
      card.classList.remove('is-revealed');
      play.setAttribute('aria-disabled', 'true');
      skip.hidden = false;
      requestAnimationFrame(() => {
        card.classList.add('is-sparkling');
        timer = setTimeout(finish, 1300);
      });
    });
    skip.addEventListener('click', () => {
      finish();
      play.focus();
    });
  });
</script>
<style>
  .powder-price {
    container-type: inline-size;
  }
  .provider-overlay strong {
    font-size: clamp(16px, 8cqw, 34px);
    white-space: nowrap;
  }
</style>
