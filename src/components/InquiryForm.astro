---
import Icon from './Icon.astro';
import { hasServerForm, href, site } from '../lib/site';
const action = href('/thank-you');
---

<p class="form-note">
  {
    hasServerForm ? (
      <>
        We use your details to understand and respond to your inquiry. Read our{' '}
        <a href={href('/privacy')}>privacy information</a>. You can also{' '}
        <a href={`mailto:${site.email}`}>email us directly</a>.
      </>
    ) : (
      <>
        This review site prepares an email in your email app. You review it and send it there.
        Nothing is submitted or stored by this form. You can also{' '}
        <a href={`mailto:${site.email}`}>email us directly</a>.
      </>
    )
  }
</p>
<form
  id="inquiry-form"
  name={hasServerForm ? 'inquiry' : undefined}
  method={hasServerForm ? 'POST' : undefined}
  action={hasServerForm ? action : undefined}
  data-netlify={hasServerForm ? 'true' : undefined}
  netlify-honeypot={hasServerForm ? 'bot-field' : undefined}
  data-mode={hasServerForm ? 'server' : 'draft'}
  data-email={site.email}
>
  {
    hasServerForm && (
      <>
        <input type="hidden" name="form-name" value="inquiry" />
        <p class="inquiry-honeypot" aria-hidden="true">
          <label for="bot-field">Leave this field empty</label>
          <input id="bot-field" name="bot-field" tabindex="-1" autocomplete="off" />
        </p>
      </>
    )
  }
  <fieldset id="inquiry-fields" disabled={!hasServerForm}>
    <div class="field-row">
      <div class="field">
        <label for="name">Your name</label><input
          id="name"
          name="name"
          autocomplete="name"
          required
          pattern=".*\S.*"
          title="Enter your name using at least one non-space character."
          maxlength="100"
        />
      </div><div class="field">
        <label for="email">Email address</label><input
          id="email"
          name="email"
          type="email"
          autocomplete="email"
          required
          maxlength="254"
        />
      </div>
    </div><div class="field">
      <label for="business">Business or organization <span class="small">(optional)</span></label
      ><input id="business" name="business" autocomplete="organization" maxlength="160" />
    </div><div class="field">
      <label for="interest">What could use a hand?</label><select id="interest" name="interest"
        ><option>Help me work out where to start</option><option>Local search and Google Ads</option
        ><option>Website and messaging</option><option>Marketing operations and automation</option
        ><option>Strategy and delivery support</option></select
      >
    </div><div class="field">
      <label for="message">What feels stuck?</label><textarea
        id="message"
        name="message"
        required
        maxlength="3000"
        aria-describedby="message-help"></textarea><small id="message-help"
        >A few sentences about the situation and what you hope to change.</small
      >
    </div><div class="form-actions">
      <button class="button" id="send-inquiry" type="submit">
        <span>{hasServerForm ? 'Send inquiry' : 'Open email draft'}</span><Icon />
      </button>
      {
        !hasServerForm && (
          <button class="button button-outline" id="copy-inquiry" type="button">
            Copy inquiry <Icon name="right" />
          </button>
        )
      }
    </div>
    <p id="form-status" class="form-status" role="status" aria-live="polite" tabindex="-1"></p>
    {
      !hasServerForm && (
        <div id="copy-fallback" class="field" hidden>
          <label for="inquiry-copy">Copy this message into your email</label>
          <textarea id="inquiry-copy" aria-describedby="form-status" readonly rows="8" />
        </div>
      )
    }
  </fieldset>
  {
    !hasServerForm && (
      <noscript>
        <p>
          Email <a href={`mailto:${site.email}`}>{site.email}</a> directly. The draft builder
          requires JavaScript.
        </p>
      </noscript>
    )
  }
</form>

<style>
  .inquiry-honeypot {
    position: absolute;
    overflow: hidden;
    clip-path: inset(50%);
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    border: 0;
    white-space: nowrap;
  }
</style>

<script>
  import { serializeInquiry, submitInquiry } from '../lib/inquiry.mjs';

  const form = document.querySelector<HTMLFormElement>('#inquiry-form');
  const status = document.querySelector<HTMLElement>('#form-status');
  const fields = document.querySelector<HTMLFieldSetElement>('#inquiry-fields');
  if (form && fields && status) {
    const validate = () => {
      for (const id of ['name', 'email', 'business', 'message']) {
        const field = form.querySelector<HTMLInputElement | HTMLTextAreaElement>(`#${id}`);
        if (!field) continue;
        field.value = field.value.trim();
        field.setCustomValidity(
          field.required && !field.value ? 'Please complete this field before continuing.' : '',
        );
      }
      return form.reportValidity();
    };
    form.addEventListener('input', (event) => {
      if (event.target instanceof HTMLInputElement || event.target instanceof HTMLTextAreaElement)
        event.target.setCustomValidity('');
    });

    if (form.dataset.mode === 'server') {
      let pending = false;
      let accepted = false;
      const label = form.querySelector<HTMLElement>('#send-inquiry span');
      window.addEventListener('pageshow', (event) => {
        if (!event.persisted || !accepted) return;
        pending = false;
        fields.disabled = false;
        form.removeAttribute('aria-busy');
        if (label) label.textContent = 'Send inquiry';
        status.textContent =
          'Your previous inquiry was submitted. You can edit this form to send a new note.';
      });
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (pending || !validate()) return;
        const action = form.getAttribute('action');
        if (!action) return;
        const body = serializeInquiry(new FormData(form));
        pending = true;
        accepted = false;
        fields.disabled = true;
        form.setAttribute('aria-busy', 'true');
        if (label) label.textContent = 'Sending…';
        status.textContent = 'Sending your inquiry. Please keep this page open.';

        const outcome = await submitInquiry(action, body);
        form.removeAttribute('aria-busy');
        if (outcome === 'accepted') {
          accepted = true;
          status.textContent = 'The website accepted your inquiry. Opening the confirmation page.';
          window.location.assign(action);
          return;
        }

        pending = false;
        fields.disabled = false;
        if (label) label.textContent = 'Send inquiry';
        const reason =
          outcome === 'timed-out'
            ? 'The request took too long to confirm.'
            : outcome === 'rejected'
              ? 'The website returned an error.'
              : 'The connection ended before we could confirm the result.';
        const emailLink = document.createElement('a');
        emailLink.href = `mailto:${form.dataset.email}`;
        emailLink.textContent = form.dataset.email || 'email us';
        status.replaceChildren(
          document.createTextNode(
            `${reason} We cannot confirm whether your inquiry was received. Your message is still here. Please email `,
          ),
          emailLink,
          document.createTextNode(' to check before trying again.'),
        );
        status.focus();
      });
    } else {
      const copyButton = document.querySelector<HTMLButtonElement>('#copy-inquiry');
      const fallback = document.querySelector<HTMLElement>('#copy-fallback');
      const copyArea = document.querySelector<HTMLTextAreaElement>('#inquiry-copy');
      if (copyButton && fallback && copyArea) {
        const compose = () => {
          const data = new FormData(form);
          const value = (key: string) => String(data.get(key) || '').trim();
          return {
            subject: `Website inquiry: ${value('interest')}`,
            body: `Name: ${value('name')}\nEmail: ${value('email')}\nBusiness: ${value('business') || 'Not provided'}\nHelp with: ${value('interest')}\n\n${value('message')}`,
          };
        };
        const showFallback = (text: string) => {
          fallback.hidden = false;
          copyArea.value = text;
        };
        form.addEventListener('submit', (event) => {
          event.preventDefault();
          if (!validate()) return;
          const { subject, body } = compose();
          showFallback(`To: ${form.dataset.email}\nSubject: ${subject}\n\n${body}`);
          const url = `mailto:${form.dataset.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
          if (url.length > 1900) {
            status.textContent =
              'Your note is ready below. It is too long for a reliable email-app link. Copy it and email it to ' +
              form.dataset.email +
              '. Nothing has been sent.';
            copyArea.focus();
            return;
          }
          status.textContent =
            'Your email app should open a draft. Review it and send it there. If it does not open, copy your inquiry below. Nothing has been sent by this website.';
          window.location.href = url;
        });
        copyButton.addEventListener('click', async () => {
          if (!validate()) return;
          const { subject, body } = compose();
          const text = `To: ${form.dataset.email}\nSubject: ${subject}\n\n${body}`;
          showFallback(text);
          copyButton.disabled = true;
          try {
            if (!navigator.clipboard) throw new Error('Clipboard unavailable');
            await navigator.clipboard.writeText(text);
            status.textContent =
              'Inquiry copied. Paste it into your email app and send it to ' +
              form.dataset.email +
              '. Nothing has been sent by this website.';
          } catch {
            status.textContent =
              'Automatic copying is unavailable. Select and copy the prepared message below, then paste it into your email app.';
            copyArea.focus();
            copyArea.select();
          } finally {
            copyButton.disabled = false;
          }
        });
        fields.disabled = false;
      }
    }
  }
</script>
