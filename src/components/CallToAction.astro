---
import { href } from '../lib/site';
import Icon from './Icon.astro';
interface Props {
  title?: string;
  text?: string;
}
const {
  title = 'What feels stuck right now?',
  text = "Let's talk about your business, the work that would help and what it takes to get started.",
} = Astro.props;
---

<section class="contact-band">
  <div class="wrap contact-band-inner">
    <div><h2>{title}</h2><p>{text}</p></div>
    <a class="button button-white" href={href('/contact') + '#request'}>Schedule a call <Icon /></a>
  </div>
</section>
