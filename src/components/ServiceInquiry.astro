---
import { services } from '../lib/service-catalog';
import { adSpendOptions, conversationBookingUrl } from '../lib/service-request.mjs';
interface Props {
  selected?: string;
  allowUndecided?: boolean;
}
const { selected = '', allowUndecided = false } = Astro.props;
const requestServices = services.map((service) => ({
  slug: service.slug,
  title: service.shortTitle,
  category: service.category,
  costs: service.costs,
  deliverables: service.deliverables,
  preparation: service.preparation,
  scopeReview: service.scopeReview,
}));
// Only configure a verified existing FM work-calendar destination.
let bookingUrl = '';
try {
  const candidate = new URL(conversationBookingUrl);
  if (candidate.protocol === 'https:' && !candidate.username && !candidate.password)
    bookingUrl = candidate.href;
} catch {
  /* The empty configuration stays visibly pending. */
}
---

<section class="request-panel" id="request" aria-labelledby="request-heading">
  <div class="request-intro">
    <p class="eyebrow">A small first step</p>
    <h2 id="request-heading">Let's talk about<br />what would help.</h2>
    <p>
      Schedule a call with Force Multiplier. We'll talk through your goals, the service that fits
      and what we need to get started.
    </p>
    <ol class="simple-steps">
      <li>Have a conversation about your business, scope and account access.</li>
      <li>Review and sign a separate service agreement, with outside costs made clear.</li>
      <li>
        Complete the appropriate onboarding and access steps, then agree the service and billing
        start.
      </li>
    </ol>
    <p>
      Monthly services are $400 each, month-to-month, with recurring billing through QuickBooks.
      One-time projects are $400 each on their agreed billing terms. Required inputs and access come
      before the agreed start.
    </p>
    <div class="schedule-panel" aria-labelledby="schedule-heading">
      <h3 id="schedule-heading">Schedule a call</h3>
      {
        bookingUrl ? (
          <>
            <a class="button" href={bookingUrl} data-schedule-link>
              Schedule a call
            </a>
            <p class="small">
              Choose a time on our work calendar. You don't need to fill out the optional brief
              below first.
            </p>
          </>
        ) : (
          <p class="preview-note" data-schedule-pending>
            <strong>Review preview:</strong> the work-calendar scheduling link is being confirmed.
            Booking is not available in this preview, and no time has been reserved.
          </p>
        )
      }
      <p class="small">
        Prefer email? <a href="mailto:john.dye@forcemultiplier.work"
          >john.dye@forcemultiplier.work</a
        >
      </p>
    </div>
  </div>
  <div class="brief-panel">
    <p class="eyebrow">Optional: a few notes for the call</p>
    <h3>What would you like to talk about?</h3>
    <p>
      You can prepare a short brief here, or simply bring your questions to the conversation. This
      step is optional.
    </p>
    <p class="preview-note">
      The brief stays on this page. Nothing is sent or saved. Use sample details for this review,
      and leave out passwords and account credentials.
    </p>
    <form
      class="service-inquiry"
      data-demo-inquiry
      data-services={JSON.stringify(requestServices)}
      data-allow-undecided={String(allowUndecided)}
    >
      <fieldset disabled data-demo-fields>
        <div class="field">
          <label for="service-choice">What kind of help interests you?</label>
          <select id="service-choice" name="service" required>
            <option value="">Choose a service</option>
            {
              services.map((service) => (
                <option
                  value={service.slug}
                  selected={selected === service.slug}
                  data-frequency={service.category}
                >
                  {service.shortTitle} - $400{' '}
                  {service.category === 'monthly' ? 'per month' : 'one time'}
                </option>
              ))
            }
            {allowUndecided && <option value="help-choose">Help me choose a service</option>}
          </select>
        </div>
        <div class="field">
          <label for="request-business">Business name <span>(optional)</span></label>
          <input
            id="request-business"
            name="business"
            autocomplete="organization"
            maxlength="150"
          />
        </div>
        <div class="field">
          <label for="request-website">Website <span>(optional)</span></label>
          <input
            id="request-website"
            name="website"
            type="url"
            autocomplete="url"
            placeholder="https://example.com"
            maxlength="500"
          />
        </div>
        <div class="field" data-ad-fields hidden>
          <label for="request-ad-spend">Estimated monthly ad spend <span>(optional)</span></label>
          <select id="request-ad-spend" name="adSpend" disabled aria-describedby="ad-spend-hint">
            <option value="">Discuss on the call</option>
            {adSpendOptions.map(([value, label]) => <option value={value}>{label}</option>)}
          </select>
          <small id="ad-spend-hint"
            >Separate from the $400 management fee. This estimate does not authorize spending.</small
          >
        </div>
        <div class="field">
          <label for="request-details"
            >What would make the work useful? <span>(optional)</span></label
          >
          <textarea id="request-details" name="details" rows="3" maxlength="2000"></textarea>
        </div>
        <label class="check-field"
          ><input type="checkbox" name="needsReview" /><span
            >I have a question about scope or need help choosing the right service.</span
          ></label
        >
        <div class="before-payment">
          <strong>A clear fee. A separate agreement.</strong>
          <p>
            Each service is $400. Monthly work is month-to-month; one-time projects have their own
            agreed billing terms. Advertising spend, software, hosting, domains and other
            third-party costs are separate where needed and agreed before work begins.
          </p>
        </div>
        <button class="button" type="submit" disabled data-demo-submit
          >Prepare my conversation brief</button
        >
      </fieldset>
      <noscript
        ><p>
          The optional brief needs JavaScript. You can still use the scheduling information and
          email link above, and read all service details. No information has been sent.
        </p></noscript
      >
      <div
        class="request-result"
        tabindex="-1"
        hidden
        aria-labelledby="result-heading"
        data-step-review
      >
        <p class="eyebrow">Your notes, ready to review</p>
        <h3 id="result-heading">Your conversation brief</h3>
        <p data-conversation-note></p>
        <p data-request-summary></p>
        <p data-request-goals></p>
        <ul data-request-context></ul>
        <h4>The service we're discussing</h4>
        <ul data-request-included></ul>
        <div class="before-payment">
          <strong>Scope to discuss together</strong>
          <p>
            These details need confirmation for your business. Proposed limits are not approved
            commitments; this brief is not a final agreement.
          </p>
          <ul data-request-scope></ul>
        </div>
        <p data-outside-costs></p>
        <p data-next-step></p>
        <details>
          <summary>What we may need after the agreement</summary><ul data-preparation-items></ul><p>
            We'll plan appropriate access together. Do not send passwords or account credentials in
            this brief or by email.
          </p>
        </details>
        <a class="button" href={bookingUrl || '#schedule-heading'}>Schedule a call</a>
        <button type="button" class="text-link" data-edit-request>Edit my brief</button>
      </div>
    </form>
  </div>
</section>
<style>
  .service-inquiry [hidden] {
    display: none;
  }
  .service-inquiry small {
    font-size: 12px;
    line-height: 1.6;
  }
  .service-inquiry .eyebrow {
    color: var(--blue);
  }
  .schedule-panel {
    margin-top: 28px;
    padding: 24px;
    background: var(--cream);
    color: var(--navy);
    border-left: 5px solid var(--coral);
  }
  .schedule-panel .preview-note {
    color: var(--navy);
  }
  .schedule-panel a {
    overflow-wrap: anywhere;
  }
  .schedule-panel .button {
    margin-block: 8px;
  }
  .brief-panel {
    min-width: 0;
  }
  .request-result ul {
    padding-left: 20px;
    font-size: 14px;
    line-height: 1.7;
  }
  .request-result li + li {
    margin-top: 8px;
  }
  .request-result .button {
    font-size: 14px;
    margin-block: 12px;
  }
  .request-result .text-link {
    display: block;
  }
  .request-result h4 {
    font-size: 17px;
    margin-top: 24px;
  }
  [data-demo-fields],
  .request-result,
  #schedule-heading {
    scroll-margin-block-start: 24px;
  }
</style>
<script>
  import {
    buildRequestPreview,
    needsAdSpend,
    validateConversationBrief,
  } from '../lib/service-request.mjs';
  import type { RequestService } from '../lib/service-request.mjs';
  document.querySelectorAll<HTMLFormElement>('[data-demo-inquiry]').forEach((form) => {
    const fields = form.querySelector<HTMLFieldSetElement>('[data-demo-fields]');
    const submit = form.querySelector<HTMLButtonElement>('[data-demo-submit]');
    const review = form.querySelector<HTMLElement>('[data-step-review]');
    const choice = form.querySelector<HTMLSelectElement>('[name="service"]');
    const adFields = form.querySelector<HTMLElement>('[data-ad-fields]');
    const adSpend = form.querySelector<HTMLSelectElement>('[name="adSpend"]');
    if (!fields || !submit || !review || !choice || !adFields || !adSpend) return;
    let catalog: RequestService[];
    try {
      catalog = JSON.parse(form.dataset.services || '[]');
    } catch {
      return;
    }
    const controls = form.querySelectorAll<
      HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement
    >('input, select, textarea');
    const sync = () => {
      adFields.hidden = !needsAdSpend(choice.value);
      adSpend.disabled = adFields.hidden;
    };
    const validate = () => {
      sync();
      const validation = validateConversationBrief(
        Object.fromEntries(new FormData(form)),
        catalog,
        form.dataset.allowUndecided === 'true',
      );
      controls.forEach((control) =>
        control.setCustomValidity(control.disabled ? '' : validation.errors[control.name] || ''),
      );
      return validation;
    };
    const setText = (selector: string, value: string) => {
      const element = form.querySelector<HTMLElement>(selector);
      if (element) element.textContent = value;
    };
    const setList = (selector: string, values: string[]) => {
      const element = form.querySelector<HTMLElement>(selector);
      if (!element) return;
      element.replaceChildren(
        ...values.map((value) => {
          const item = document.createElement('li');
          item.textContent = value;
          return item;
        }),
      );
    };
    form.addEventListener('input', validate);
    form.addEventListener('change', validate);
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const validation = validate();
      if (!form.reportValidity() || !validation.valid) return;
      const preview = buildRequestPreview(validation);
      setText('[data-conversation-note]', preview.conversationNote);
      setText('[data-request-summary]', preview.summary);
      setText('[data-request-goals]', preview.goals);
      setList('[data-request-context]', preview.context);
      setList('[data-request-included]', preview.included);
      setList('[data-request-scope]', preview.scope);
      setList('[data-preparation-items]', preview.preparation);
      setText('[data-outside-costs]', preview.outsideCosts);
      setText('[data-next-step]', preview.nextStep);
      fields.hidden = true;
      review.hidden = false;
      review.focus({ preventScroll: true });
      review.scrollIntoView({ block: 'start', behavior: 'instant' });
    });
    form.querySelector('[data-edit-request]')?.addEventListener('click', () => {
      review.hidden = true;
      fields.hidden = false;
      choice.focus({ preventScroll: true });
      fields.scrollIntoView({ block: 'start', behavior: 'instant' });
    });
    fields.disabled = false;
    submit.disabled = false;
    sync();
  });
</script>
