---
import { agencyBenchmarks } from '../lib/agency-benchmarks';
import { services } from '../lib/service-catalog';
import { href } from '../lib/site';
---

<section
  class="comparison-section section"
  id="price-comparison"
  aria-labelledby="comparison-title"
  data-price-comparison
>
  <div class="wrap">
    <div class="comparison-intro">
      <div>
        <p class="eyebrow">A little help. A clear price.</p>
        <h2 id="comparison-title">Eleven useful services.<br />$400 each.</h2>
      </div>
      <div class="comparison-explanation">
        <p>
          Estimated agency costs, next to our $400 fee. Scroll through and watch the numbers find a
          new home.
        </p>
        <p class="comparison-small">
          Modeled comparable-service SMB-to-enterprise fees for the scopes shown; actual quotes
          vary.
        </p>
      </div>
    </div>
    <div class="comparison-toolbar">
      <p class="comparison-small" data-comparison-status aria-live="polite">
        Seven monthly services. Four one-time projects. All prices in USD.
      </p>
      <div class="comparison-controls" hidden data-comparison-controls>
        <button type="button" data-stop-comparisons>Show all prices now</button>
        <button type="button" data-replay-comparisons hidden
          >Replay as I scroll <span aria-hidden="true">↻</span></button
        >
      </div>
    </div>
    <div
      class="comparison-table"
      role="table"
      aria-label="Eleven services: Other Agencies and Force Multiplier fees"
    >
      <div class="comparison-table-head" role="row">
        <div role="columnheader">Offering / description</div>
        <div role="columnheader">Other Agencies</div>
        <div role="columnheader">Force Multiplier</div>
      </div>
      <div role="rowgroup">
        {
          agencyBenchmarks.map((benchmark, index) => {
            const service = services.find((item) => item.slug === benchmark.slug)!;
            return (
              <div
                class="comparison-row"
                role="row"
                data-comparison-row
                data-service={service.slug}
                data-state="static"
                data-cadence={service.category}
              >
                <div class="comparison-service" role="rowheader">
                  <span class="comparison-index">
                    {String(index + 1).padStart(2, '0')} /{' '}
                    {service.category === 'monthly' ? 'MONTHLY' : 'ONE TIME'}
                  </span>
                  <h3>
                    <a href={href(`/services/${service.slug}`)}>{service.title}</a>
                  </h3>
                  <p>{service.benefit}</p>
                  {benchmark.scenarioLabel && (
                    <p class="comparison-scenario" data-comparison-scenario>
                      {benchmark.scenarioLabel}
                    </p>
                  )}
                  <a class="comparison-scope-link" href={href(`/services/${service.slug}`)}>
                    See FM scope <span aria-hidden="true">↗</span>
                  </a>
                </div>
                <div class="comparison-price-track" role="presentation" data-price-track>
                  <div class="comparison-agency" role="cell" aria-label="Other Agencies">
                    <span
                      class="comparison-cell-label"
                      data-price-label="agency"
                      aria-hidden="true"
                    >
                      Other Agencies
                    </span>
                    <div class="comparison-number-block">
                      <div class="comparison-number-line">
                        <strong class="comparison-source-number" data-source-number>
                          {benchmark.price}
                        </strong>
                        <details class="comparison-source-info" data-source-info>
                          <summary
                            aria-label={`About the ${service.shortTitle.toLowerCase()} agency estimate`}
                            title="About this agency estimate"
                          >
                            <span aria-hidden="true">i</span>
                          </summary>
                          <div
                            class="comparison-evidence"
                            role="region"
                            aria-label={`${service.shortTitle}: agency estimate`}
                          >
                            <p data-comparison-summary>{benchmark.tooltipSummary}</p>
                            <button
                              type="button"
                              class="comparison-source-close"
                              data-close-source
                              hidden
                            >
                              Close source details
                            </button>
                          </div>
                        </details>
                      </div>
                      {benchmark.period && (
                        <span class="comparison-period">{benchmark.period}</span>
                      )}
                    </div>
                  </div>
                  <div
                    class="comparison-fm"
                    role="cell"
                    aria-label={`Force Multiplier: $400 ${benchmark.fmPeriod}`}
                  >
                    <span class="comparison-cell-label" data-price-label="fm" aria-hidden="true">
                      Force Multiplier
                    </span>
                    <div class="comparison-fm-result" data-fm-result>
                      <strong class="comparison-target-number" data-target-number>
                        $400
                      </strong>
                      <span class="comparison-period">{benchmark.fmPeriod}</span>
                    </div>
                  </div>
                  <canvas class="comparison-canvas" data-price-canvas aria-hidden="true" />
                </div>
              </div>
            );
          })
        }
      </div>
    </div>
  </div>
</section>

<script>
  import { initPriceComparisons } from '../lib/price-particles';
  initPriceComparisons();
</script>

<style>
  .comparison-section {
    background: var(--cream);
    scroll-margin-top: 20px;
  }
  .comparison-intro {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 54px;
    align-items: end;
  }
  .comparison-intro h2 {
    font-size: clamp(32px, 4vw, 54px);
    line-height: 1.13;
    margin-bottom: 0;
    color: var(--navy);
  }
  .comparison-explanation p {
    margin: 0 0 12px;
  }
  .comparison-explanation p:last-child {
    margin-bottom: 0;
  }
  .comparison-small {
    font-size: 13px;
    line-height: 1.7;
  }
  .comparison-toolbar {
    display: flex;
    gap: 24px;
    align-items: center;
    justify-content: space-between;
    margin: 28px 0 18px;
    min-height: 44px;
  }
  .comparison-toolbar > p {
    max-width: 640px;
    margin: 0;
  }
  .comparison-controls {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  .comparison-controls button {
    min-height: 44px;
    padding: 6px 0;
    border: 0;
    background: transparent;
    color: var(--blue);
    text-decoration: underline;
    text-underline-offset: 4px;
    font-size: 12px;
    font-weight: 600;
  }
  .comparison-table {
    position: relative;
    isolation: isolate;
    border: 1px solid #b9c8d6;
    border-radius: 12px;
    background: #fff;
  }
  .comparison-table-head {
    display: grid;
    grid-template-columns: 35% 42% 23%;
    border-radius: 11px 11px 0 0;
    color: #fff;
    background: var(--navy);
  }
  @media (min-width: 900px) {
    .comparison-table-head {
      /* The site navigation is in normal document flow and scrolls away. */
      position: sticky;
      top: 0;
      z-index: 10;
      box-shadow: 0 2px 0 #b9c8d6;
    }
    .comparison-source-info summary,
    .comparison-source-close,
    .comparison-service a {
      scroll-margin-top: 110px;
    }
  }
  .comparison-cell-label {
    display: none;
  }
  .comparison-table-head > div {
    padding: 20px 24px;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.45;
  }
  .comparison-table-head > div:not(:first-child) {
    text-align: center;
  }
  .comparison-row {
    display: grid;
    grid-template-columns: 35% 65%;
    position: relative;
    min-height: 230px;
    border-top: 1px solid #c8d5df;
  }
  .comparison-row:first-child {
    border-top: 0;
  }
  .comparison-row:last-child .comparison-fm {
    border-radius: 0 0 11px 0;
  }
  .comparison-row:has(details[open]) {
    z-index: 5;
  }
  .comparison-service {
    padding: 28px;
  }
  .comparison-index {
    display: block;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: #4d6074;
    margin-bottom: 10px;
  }
  .comparison-service h3 {
    font-size: 21px;
    line-height: 1.3;
    margin: 0 0 10px;
  }
  .comparison-service h3 a {
    text-decoration: none;
  }
  .comparison-service h3 a:hover {
    text-decoration: underline;
  }
  .comparison-service > p {
    font-size: 13px;
    line-height: 1.65;
    margin: 0;
  }
  .comparison-service > .comparison-scenario {
    color: #43576a;
    font-size: 12px;
    margin-top: 10px;
    padding-top: 10px;
    border-top: 1px solid #e0e8ef;
  }
  .comparison-scope-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    font-size: 12px;
    color: var(--blue);
    margin-top: 4px;
  }
  .comparison-price-track {
    display: grid;
    grid-template-columns: 42fr 23fr;
    position: relative;
    min-width: 0;
  }
  .comparison-agency,
  .comparison-fm {
    min-width: 0;
    text-align: center;
    padding: 20px 12px;
  }
  .comparison-agency {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    border-left: 1px solid #e0e8ef;
  }
  .comparison-number-line {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    max-width: 100%;
  }
  .comparison-source-info {
    flex: 0 0 auto;
  }
  .comparison-source-info summary {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    cursor: pointer;
    list-style: none;
    color: var(--blue);
    -webkit-tap-highlight-color: transparent;
  }
  .comparison-source-info summary::-webkit-details-marker {
    display: none;
  }
  .comparison-source-info summary > span {
    width: 23px;
    height: 23px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1.5px solid currentColor;
    border-radius: 50%;
    font-size: 13px;
    font-weight: 600;
  }
  .comparison-source-info summary:hover > span,
  .comparison-source-info[open] summary > span {
    background: var(--blue);
    color: #fff;
    border-color: var(--blue);
  }
  .comparison-source-info summary:focus-visible {
    outline: 3px solid #bf6200;
    outline-offset: 2px;
    border-radius: 4px;
  }
  .comparison-number-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 100%;
  }
  .comparison-source-number,
  .comparison-target-number {
    display: inline-block;
    font-size: clamp(20px, 2.3vw, 30px);
    line-height: 1.3;
    font-weight: 600;
    color: var(--blue);
    white-space: nowrap;
  }
  .comparison-period {
    display: block;
    font-size: 12px;
    color: #43576a;
    line-height: 1.6;
  }
  .comparison-fm {
    display: flex;
    align-items: center;
    justify-content: center;
    background: #fff0cf;
  }
  .comparison-target-number {
    font-size: 54px;
  }
  .comparison-fm-result {
    padding-top: 16px;
  }
  .comparison-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 2;
  }
  .comparison-row:global(.has-shadow) .comparison-source-number {
    color: #9ca3af;
    text-shadow: 0 2px 0 #eff3f7;
  }
  .comparison-row:global(.motion-ready):not(:global(.is-complete)) .comparison-fm-result {
    opacity: 0;
  }
  .comparison-evidence {
    position: absolute;
    top: var(--comparison-popup-top, calc(50% + 32px));
    left: 0;
    right: 0;
    z-index: 8;
    padding: 22px;
    border: 1px solid #91a7bc;
    border-radius: 10px;
    box-shadow: 0 12px 35px #102b4624;
    background: #fff;
    text-align: left;
    color: var(--ink);
    max-height: var(--comparison-popup-max-height, calc(100dvh - 16px));
    overflow-y: auto;
  }
  .comparison-evidence p {
    font-size: 12px;
    line-height: 1.8;
    margin: 0 0 10px;
  }
  .comparison-source-close {
    min-height: 44px;
    margin-top: 8px;
    border: 0;
    padding: 6px 0;
    font-size: 12px;
    text-decoration: underline;
    background: transparent;
    color: var(--blue);
  }
  [hidden] {
    display: none !important;
  }
  @media (max-width: 899px) {
    .comparison-intro {
      gap: 24px;
      grid-template-columns: 1fr;
    }
    .comparison-toolbar {
      align-items: flex-start;
      flex-direction: column;
      gap: 8px;
    }
    .comparison-service {
      padding: 20px;
    }
    .comparison-table-head {
      grid-template-columns: 2fr 1fr;
    }
    .comparison-table-head > div:first-child {
      grid-column: 1 / -1;
      padding-bottom: 0;
    }
    .comparison-row {
      grid-template-columns: 1fr;
      min-height: 0;
    }
    .comparison-price-track {
      grid-template-columns: 2fr 1fr;
      min-height: 130px;
      border-top: 1px solid #e0e8ef;
    }
    .comparison-agency {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 44px;
      grid-template-areas: 'label info' 'price price' 'period period';
      align-content: center;
      justify-items: center;
      border-left: 0;
    }
    .comparison-agency .comparison-number-block,
    .comparison-agency .comparison-number-line {
      display: contents;
    }
    .comparison-agency .comparison-cell-label {
      grid-area: label;
      margin-bottom: 0;
    }
    .comparison-source-info {
      grid-area: info;
      justify-self: end;
    }
    .comparison-source-number {
      grid-area: price;
    }
    .comparison-agency .comparison-period {
      grid-area: period;
    }
    .comparison-fm {
      flex-direction: column;
    }
    .comparison-cell-label {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 44px;
      max-width: 100%;
      margin-bottom: 4px;
      font-size: 12px;
      font-weight: 600;
      line-height: 1.3;
      color: var(--navy);
    }
    .comparison-fm-result {
      padding-top: 0;
    }
    .comparison-service h3 {
      font-size: 18px;
    }
    .comparison-table-head > div {
      font-size: 12px;
      padding: 17px 12px;
    }
    .comparison-source-number {
      font-size: clamp(16px, 5.4vw, 28px);
    }
    .comparison-target-number {
      font-size: 38px;
    }
    .comparison-number-line {
      gap: 2px;
    }
    .comparison-source-info summary {
      width: 44px;
    }
    .comparison-source-info summary > span {
      width: 19px;
      height: 19px;
      font-size: 11px;
    }
    .comparison-evidence {
      left: 0;
    }
  }
  @media (max-width: 479px) {
    .comparison-service {
      padding: 18px;
    }
    .comparison-service h3 {
      font-size: 18px;
      line-height: 1.4;
    }
    .comparison-service > p {
      font-size: 13px;
      line-height: 1.75;
    }
    .comparison-index {
      font-size: 9px;
      letter-spacing: 0;
    }
    .comparison-scope-link {
      font-size: 12px;
      gap: 3px;
    }
    .comparison-table-head > div {
      font-size: 11px;
      padding: 16px 10px;
    }
    .comparison-agency,
    .comparison-fm {
      padding: 16px 5px;
    }
    .comparison-source-number {
      font-size: clamp(18px, 5.1vw, 24px);
    }
    .comparison-target-number {
      font-size: 31px;
    }
    .comparison-period {
      font-size: 10px;
    }
    .comparison-evidence {
      padding: 18px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .comparison-canvas,
    .comparison-controls {
      display: none !important;
    }
    .comparison-row:global(.motion-ready) .comparison-fm-result {
      opacity: 1;
    }
  }
  @media (max-width: 899px) {
    /* Without JavaScript, the native disclosure expands in the document and remains scrollable. */
    [data-price-comparison]:not([data-comparison-enhanced]) .comparison-source-info[open],
    [data-price-comparison]:not([data-comparison-enhanced])
      .comparison-source-info[open]::details-content {
      display: contents;
    }
    [data-price-comparison]:not([data-comparison-enhanced]) .comparison-source-info[open] summary {
      grid-area: info;
      justify-self: end;
    }
    [data-price-comparison]:not([data-comparison-enhanced]) .comparison-evidence {
      position: static;
      grid-column: 1 / -1;
      grid-row: 4;
      align-self: start;
      width: 100%;
      margin-top: 8px;
      max-height: none;
      overflow: visible;
    }
  }
</style>
